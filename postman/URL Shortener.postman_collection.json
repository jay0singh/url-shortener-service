{
  "info": {
    "_postman_id": "240de721-9ad9-4f3f-8b6e-50541f7153bb",
    "name": "URL Shortener",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "27125120"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "shortCode",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin"
    }
  ],
  "item": [
    {
      "name": "Shorten",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.shortUrl) {",
              "    var code = json.shortUrl.split('/').pop();",
              "    pm.collectionVariables.set('shortCode', code);",
              "    console.log('shortCode saved:', code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"url\": \"https://www.google.com\",\n    \"ttlDays\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "shorten"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Redirect",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stats/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stats",
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Deactivate",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shorten/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "shorten",
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    }
  ]
}

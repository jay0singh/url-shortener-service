{
  "info": {
    "_postman_id": "240de721-9ad9-4f3f-8b6e-50541f7153bb",
    "name": "URL Shortener",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "27125120"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "shortCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Shorten",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"url\" : \"www.google.com\",\r\n    \"ttlDays\" : 30\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "shorten"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Deactivate",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shorten/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "shorten",
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stats/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stats",
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Redirect",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{shortCode}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{shortCode}}"
          ]
        }
      },
      "response": []
    }
  ]
}
